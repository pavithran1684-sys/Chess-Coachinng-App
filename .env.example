# Required for the initial coach account in production.
COACH_EMAIL=coach@example.com
COACH_PASSWORD=replace-with-a-strong-password
COACH_NAME=Chess Coach

# Optional local storage and server overrides.
# For a Render persistent disk mounted at /data, use /data/chessdesk.db and /data/uploads.
DATABASE_PATH=./data/chessdesk.db
UPLOAD_DIR=./data/uploads

# Render supplies PORT automatically; this default is for local use.
PORT=3001
